# Every environment variable edgar-pipeline reads. Copy this file to .env (git-ignored) and fill it in.
# Nothing loads .env automatically: export the variables in your shell, e.g. `set -a; . ./.env; set +a`.
# Never commit a real value.

# Required before any SEC request. SEC fair access asks every client to send a descriptive User-Agent
# with a real contact (an email address or an http(s) URL), e.g.
#   EDGAR_USER_AGENT='Acme Research jane@example.com'
# edgar_pipeline.config.user_agent() raises ConfigError when it is unset, blank or has no contact.
# https://www.sec.gov/os/accessing-edgar-data
EDGAR_USER_AGENT=
